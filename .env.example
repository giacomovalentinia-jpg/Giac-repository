# Database (Postgres in production; anything Prisma-postgresql-compatible works locally too)
DATABASE_URL="postgresql://user:password@localhost:5432/ilmister"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-valore-casuale-con-openssl-rand-base64-32"

# Magic link email (SMTP). Se assenti, il link viene stampato in console (solo dev).
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Il Mister <no-reply@ilmister.app>"

# Claude API (chat + quiz)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"

# Stripe (abbonamento Premium 2,99€/mese)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Classifica Serie A (football-data.org)
FOOTBALL_DATA_API_KEY="..."

# Job pianificato di aggiornamento classifica: segreto condiviso col cron
CRON_SECRET="genera-un-valore-casuale"
